# انسخ هذا الملف إلى .env ثم عدّل القيم. لا تشارك .env مع أحد.
AI_API_KEY=
AI_BASE_URL=https://api.hcnsec.cn/v1
AI_MODEL=auto
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
# اتركه فارغًا للاكتشاف التلقائي، أو ضع مسار Chromium في Termux.
CHROMIUM_PATH=
PLAYWRIGHT_HEADLESS=true
CHROMIUM_NO_SANDBOX=true
PLAYWRIGHT_BROWSERS_PATH=0

# الوضع الافتراضي يجهّز المنشورات ولا ينشرها. لا تغيّرهما إلا بعد اختبار الجلسات.
DRY_RUN=true
PUBLISHING_ENABLED=false
SCHEDULER_ENABLED=true
MAX_DOWNLOAD_MB=250
MEDIA_RETENTION_DAYS=90
LOG_RETENTION_DAYS=90
AUTO_CLEANUP=true

# حماية اختيارية عند فتح الواجهة على الشبكة. لا تستخدم 0.0.0.0 دونها.
WEB_USERNAME=
WEB_PASSWORD=
